# Runtime profile: development | qa | production
# Set by `npm run dev` / `start:qa` / `start:prod` in backend/package.json —
# only needs setting here if you're running `node index.js` directly.
# development seeds a known admin login (admin@mail.com); qa/prod never do.
NODE_ENV=development

# Database
DATABASE_URL="file:../dev.db"

# Authentication
JWT_SECRET="your-secret-key-here-change-in-production"

# email
MAIL_FROM="tom@email.com"
MAX_ATTEMPTS=2
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="your-smtp-password"

# email verification
EMAIL_VERIFICATION_REQUIRED=true
FRONTEND_URL="http://localhost:5173"
