# Dev profile — safe to commit, no real secrets. Loaded when NODE_ENV=development
# (the default for `npm run dev`, see backend/package.json). A personal root
# .env, if present, still overrides any of these.
NODE_ENV=development

# Database
DATABASE_URL="file:../dev.db"

# Authentication
JWT_SECRET="dev-only-secret-not-for-qa-or-prod"

# email — unset SMTP_HOST means mail is logged, not sent (see backend/mailer.js)
MAIL_FROM="tom@email.com"
MAX_ATTEMPTS=2
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# email verification — bypassed locally so signup/login don't need real mail
EMAIL_VERIFICATION_REQUIRED=false
FRONTEND_URL="http://localhost:5173"
