generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../dev.db"
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  password          String
  role              String    @default("client")
  emailVerified     Boolean   @default(false)
  mustChangePassword Boolean  @default(false)
  verificationToken String?   @unique
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?
  createdAt         DateTime  @default(now())
  profile           UserProfile?
}

// One-time registration details. A missing row (not a boolean flag, unlike
// mustChangePassword) is what gates a user into the completion form — the
// data itself is the "is this done" signal, so there's nothing to keep in sync.
model UserProfile {
  id                      Int     @id @default(autoincrement())
  userId                  Int     @unique
  user                    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName               String
  lastName                String
  address                 String
  address2                String?
  state                   String
  zip                     String
  country                 String  @default("US")
  phone                   String
  communicationPreference String  @default("email")
  linkedin                String?
  github                  String?
  altEmail                String?
}

model EmailQueue {
  id        Int       @id @default(autoincrement())
  to        String
  subject   String
  body      String
  status    String    @default("pending")
  attempts  Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?
}
