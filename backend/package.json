{
  "name": "backend-api",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "prestart": "prisma migrate deploy",
    "start": "node index.js",
    "start:qa": "NODE_ENV=qa node index.js",
    "start:prod": "NODE_ENV=production node index.js",
    "predev": "prisma migrate deploy",
    "dev": "NODE_ENV=development node --watch index.js",
    "pretest": "prisma migrate deploy && cp dev.db dev.test.db",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config=jest.config.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.6"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "supertest": "^6.3.3"
  }
}
